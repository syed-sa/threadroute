# ---------------------------------------------------------------------------------------
# ThreadRoute configuration. Copy this file to ".env" and fill in what you have.
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
# ---------------------------------------------------------------------------------------

# --- REQUIRED for chat / web / eval: a Gemini API key (free): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Alternative: use Vertex AI instead of an API key (leave GOOGLE_API_KEY empty)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Models. Verify current names at https://ai.google.dev/gemini-api/docs/models
# Run `python -m threadroute doctor` to check these exist for your key.
# If the primary model fails, the agents automatically try the fallbacks in order.
THREADROUTE_MODEL=gemini-3.8-flash
THREADROUTE_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# --- OPTIONAL: switch external data from built-in mock providers to live Google/other APIs.
# With false (default) everything runs offline with realistic mock data - no other keys needed.
# With true, live providers go first and the mock providers stay behind them as automatic fallbacks.
THREADROUTE_LIVE_APIS=false

# Google Maps Routes API (enable "Routes API" in Google Cloud, create an API key). Road legs only.
GOOGLE_MAPS_API_KEY=

# Gmail + Google Sheets (OAuth). Download an OAuth client JSON ("Desktop app") from Google Cloud,
# point to it here, then run once:  python -m threadroute google-auth
GOOGLE_OAUTH_CREDENTIALS=
GOOGLE_SHEET_ID=

# Point carrier tracking at a real aggregator instead of the built-in mock carrier API
CARRIER_API_BASE_URL=

# Where claim emails go and who they are sent from
CLAIMS_EMAIL_TO=claims@carrier-desk.example.com
OPS_EMAIL=ops@aurelio-menswear.example.com

# --- OPTIONAL
# Folder for the local databases, outbox and action log (default: ./.threadroute)
# THREADROUTE_HOME=
# Show MCP server subprocess logs
# THREADROUTE_DEBUG=false
